# Server Configuration
NODE_ENV=development
PORT=3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES=86400

# Admin User (role: admin - acesso total)
ADMIN_USERNAME=admin
# Gere seu hash com: npx tsx -e "import bcrypt from 'bcryptjs'; console.log(bcrypt.hashSync('sua-senha', 10))"
ADMIN_PASSWORD_HASH=$2a$10$SEU_HASH_AQUI

# Operator 1 (role: operator - status, update, players)
OPERATOR1_USERNAME=operator1
OPERATOR1_PASSWORD_HASH=$2a$10$SEU_HASH_AQUI

# Operator 2 (role: operator - status, update, players)
OPERATOR2_USERNAME=operator2
OPERATOR2_PASSWORD_HASH=$2a$10$SEU_HASH_AQUI

# SSH Configuration
VPS_IP=your-server-ip
SSH_USER=your-ssh-username
SSH_KEY=path-to-ssh-private-key-content
BEDROCK_MANAGER_PATH=/home/ubuntu/bedrock_manager.sh
BEDROCK_MANAGER_BASH_PATH=/usr/bin/bash

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
